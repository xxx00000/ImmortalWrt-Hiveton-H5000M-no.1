#!/bin/sh
# Persist a device-local key before the auto-started WebSocket server listens.
# Never write the key to stdout, logs, build output, or the source repository.
set -eu

key="$(uci -q get at-webserver.config.websocket_auth_key || true)"
[ -z "$key" ] || exit 0

# Python is a required runtime of at-webserver; BusyBox does not ship od here.
key="$(python3 -c 'import secrets; print(secrets.token_hex(32))')"
[ "${#key}" -eq 64 ] || exit 1
case "$key" in *[!0-9a-f]*) exit 1 ;; esac
uci -q set "at-webserver.config.websocket_auth_key=$key"
uci -q commit at-webserver
[ "$(uci -q get at-webserver.config.websocket_auth_key)" = "$key" ]
