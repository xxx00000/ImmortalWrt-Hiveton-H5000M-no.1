#!/bin/sh
case "$1" in
	mt5700) others='fm350d qmodem_init qmodem_network qmodem-worker' ;;
	fm350) others='at-webserver qmodem_init qmodem_network qmodem-worker' ;;
	quectel) others='at-webserver fm350d' ;;
	*) exit 1 ;;
esac
for service in $others; do
	[ -x "/etc/init.d/$service" ] && "/etc/init.d/$service" stop >/dev/null 2>&1
done
exit 0
