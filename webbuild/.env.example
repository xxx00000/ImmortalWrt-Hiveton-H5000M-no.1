# Copy to .env. Never commit .env or a GitHub App private key.
PUBLIC_HOST=build.example.com
PUBLIC_ORIGIN=https://build.example.com
GITHUB_APP_ID=replace-me
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_INSTALLATION_ID=replace-me
# Exactly 32 random bytes encoded as base64. Keep this stable across restarts.
DATA_KEY=replace-me
# Exact reviewed commit on Hiveton-H5000M-WebBuild; update only after reviewing branch changes.
EXPECTED_SHA=replace-me
