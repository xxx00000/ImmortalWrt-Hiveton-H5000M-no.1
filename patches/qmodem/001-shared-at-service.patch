diff --git a/application/ubus_at_daemon/src/session.c b/application/ubus_at_daemon/src/session.c
new file mode 100644
index 0000000..5a54a1f
--- /dev/null
+++ b/application/ubus_at_daemon/src/session.c
@@ -0,0 +1,137 @@
+#include "ubus_at_daemon.h"
+#include <ctype.h>
+#include <strings.h>
+
+static uint64_t monotonic_ms(void) {
+    struct timespec now; clock_gettime(CLOCK_MONOTONIC, &now);
+    return (uint64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+static int valid_owner(const char *owner) {
+    if (!owner || strlen(owner) < 32 || strlen(owner) > 64) return 0;
+    for (const unsigned char *p = (const unsigned char *)owner; *p; ++p)
+        if (!isxdigit(*p)) return 0;
+    return 1;
+}
+static int is_quarantined(at_port_instance_t *port) {
+    pthread_mutex_lock(&port->response_mutex);
+    int result = port->quarantined;
+    pthread_mutex_unlock(&port->response_mutex); return result;
+}
+static void quarantine(at_port_instance_t *port) {
+    pthread_mutex_lock(&port->response_mutex);
+    port->quarantined = 1;
+    pthread_mutex_unlock(&port->response_mutex);
+}
+/* No finite delay proves that a timed-out modem has stopped replying. Keep the
+ * reader draining, reject new work, and require device recovery + daemon restart.
+ * A known prompt may be cancelled with ESC and a confirmed final response. */
+static int end_session(at_port_instance_t *port) {
+    int result = 0;
+    pthread_mutex_lock(&port->response_mutex);
+    int prompt = port->prompt_pending;
+    pthread_mutex_unlock(&port->response_mutex);
+    pthread_mutex_lock(&port->state_mutex);
+    int opened = port->is_open;
+    pthread_mutex_unlock(&port->state_mutex);
+    if (prompt && !opened) quarantine(port);
+    if (prompt && !is_quarantined(port)) {
+        at_response_t reply;
+        result = send_at_command_with_response(port, "1b", 2, NULL, 1, &reply);
+        if (result == -1 || !reply.end_flag_matched[0]) quarantine(port);
+        pthread_mutex_lock(&port->response_mutex);
+        port->prompt_pending = 0;
+        pthread_mutex_unlock(&port->response_mutex);
+    }
+    port->lease_owner[0] = 0; port->lease_deadline_ms = 0;
+    return is_quarantined(port) ? -2 : 0;
+}
+static void expire_session(at_port_instance_t *port) {
+    if (port->lease_owner[0] && monotonic_ms() >= port->lease_deadline_ms)
+        end_session(port);
+}
+int at_session_acquire(at_port_instance_t *port, const char *owner, int ttl, int baudrate) {
+    if (!port || !valid_owner(owner) || ttl < 1 || ttl > 120 || baudrate != 115200) return -2;
+    pthread_mutex_lock(&port->session_mutex);
+    expire_session(port);
+    int result = 0;
+    if (is_quarantined(port)) result = -2;
+    else if (port->lease_owner[0] && strcmp(port->lease_owner, owner)) result = 1;
+    else {
+        pthread_mutex_lock(&port->state_mutex);
+        int disconnected_owner = port->lease_owner[0] && !port->is_open;
+        pthread_mutex_unlock(&port->state_mutex);
+        if (disconnected_owner) quarantine(port);
+        if (disconnected_owner || open_at_port(port, baudrate, 8, 0, 1)) result = -2;
+    }
+    if (result == 0) {
+        strcpy(port->lease_owner, owner);
+        port->lease_deadline_ms = monotonic_ms() + (uint64_t)ttl * 1000;
+    }
+    pthread_mutex_unlock(&port->session_mutex); return result;
+}
+int at_session_release(at_port_instance_t *port, const char *owner) {
+    if (!port || !valid_owner(owner)) return -2;
+    pthread_mutex_lock(&port->session_mutex);
+    expire_session(port);
+    int result = strcmp(port->lease_owner, owner) ? -2 : end_session(port);
+    pthread_mutex_unlock(&port->session_mutex); return result;
+}
+int at_session_send(at_port_instance_t *port, const char *owner, const char *cmd,
+                    int timeout, const char *end_flag, int raw, at_response_t *response) {
+    if (response) { memset(response, 0, sizeof(*response)); response->status = -2; }
+    if (!port || !response || !valid_owner(owner) || !cmd || !*cmd ||
+        timeout < 1 || timeout > 60 || strlen(cmd) > 8192 ||
+        (end_flag && strlen(end_flag) > 255)) return -2;
+    /* Only a modem terminal or a prompt may finish a transaction. An arbitrary
+     * intermediate prefix (+CMGS, +CSQ...) would leave its final OK unread. */
+    if (end_flag && *end_flag && strcmp(end_flag, ">") && strcmp(end_flag, "OK") &&
+        strcmp(end_flag, "OK,ERROR,+CME ERROR:,+CMS ERROR:")) return -2;
+    if (raw) {
+        if (strlen(cmd) % 2) return -2;
+        for (const unsigned char *p = (const unsigned char *)cmd; *p; ++p)
+            if (!isxdigit(*p)) return -2;
+    } else if (strchr(cmd, '\r') || strchr(cmd, '\n') || strchr(cmd, '\x1a') || strchr(cmd, '\x1b')) return -2;
+    pthread_mutex_lock(&port->session_mutex);
+    expire_session(port);
+    int result = -2;
+    pthread_mutex_lock(&port->response_mutex);
+    int prompt = port->prompt_pending;
+    pthread_mutex_unlock(&port->response_mutex);
+    if (is_quarantined(port) || strcmp(port->lease_owner, owner) || (prompt && !raw)) goto done;
+    if (raw) {
+        unsigned char *data = (unsigned char *)hex_to_string(cmd);
+        size_t length = strlen(cmd) / 2;
+        int framed = data != NULL;
+        if (framed && prompt) {
+            framed = (length == 1 && data[0] == 0x1b) || data[length - 1] == 0x1a;
+            for (size_t i = 0; framed && i + 1 < length; i++)
+                if (data[i] == 0x1a || data[i] == 0x1b) framed = 0;
+        } else if (framed) {
+            /* Raw AT is one command, never a pipeline with leftover terminals. */
+            size_t body = length;
+            if (body && data[body - 1] == '\n') body--;
+            if (!body || data[body - 1] != '\r') framed = 0;
+            else body--;
+            if (body < 2 || strncasecmp((char *)data, "AT", 2)) framed = 0;
+            for (size_t i = 0; framed && i < body; i++)
+                if (data[i] < 32 || data[i] > 126) framed = 0;
+        }
+        free(data);
+        if (!framed) goto done;
+    }
+    /* A disconnected lease cannot silently continue its SMS on a new stream. */
+    pthread_mutex_lock(&port->state_mutex);
+    int opened = port->is_open;
+    pthread_mutex_unlock(&port->state_mutex);
+    if (!opened) { quarantine(port); goto done; }
+    /* Renew for the operation; timeout cannot outlive its owning lease. */
+    port->lease_deadline_ms = monotonic_ms() + 120000;
+    result = send_at_command_with_response(port, cmd, timeout,
+        end_flag && !strcmp(end_flag, ">") ? ">,ERROR,+CME ERROR:,+CMS ERROR:" : NULL, raw, response);
+    if (result == -1 || (result && !response->end_flag_matched[0])) quarantine(port);
+    pthread_mutex_lock(&port->response_mutex);
+    port->prompt_pending = result == 0 && !strcmp(response->end_flag_matched, ">");
+    pthread_mutex_unlock(&port->response_mutex);
+done:
+    pthread_mutex_unlock(&port->session_mutex); return result;
+}
