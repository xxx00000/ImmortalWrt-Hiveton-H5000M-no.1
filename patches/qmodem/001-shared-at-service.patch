diff --git a/application/ubus_at_daemon/tests/host_compat.h b/application/ubus_at_daemon/tests/host_compat.h
new file mode 100644
index 0000000..a4bac9f
--- /dev/null
+++ b/application/ubus_at_daemon/tests/host_compat.h
@@ -0,0 +1,51 @@
+#ifndef QMODEM_HOST_COMPAT_H
+#define QMODEM_HOST_COMPAT_H
+#ifdef __APPLE__
+#include <unistd.h>
+#include <fcntl.h>
+#include <termios.h>
+#include <pthread.h>
+#ifndef B460800
+#define B460800 B230400
+#endif
+#ifndef B921600
+#define B921600 B230400
+#endif
+static inline int host_pipe2(int fd[2], int flags) {
+    if (pipe(fd)) return -1;
+    if (fcntl(fd[0], F_SETFL, flags & O_NONBLOCK) || fcntl(fd[1], F_SETFL, flags & O_NONBLOCK) ||
+        fcntl(fd[0], F_SETFD, FD_CLOEXEC) || fcntl(fd[1], F_SETFD, FD_CLOEXEC)) {
+        close(fd[0]); close(fd[1]); return -1;
+    }
+    return 0;
+}
+#define pipe2 host_pipe2
+#define PTHREAD_BARRIER_SERIAL_THREAD 1
+typedef struct { pthread_mutex_t mutex; pthread_cond_t cond; unsigned count, waiting, generation; } pthread_barrier_t;
+static inline int pthread_barrier_init(pthread_barrier_t *b, const void *attr, unsigned count) {
+    (void)attr; b->count = count; b->waiting = b->generation = 0;
+    pthread_mutex_init(&b->mutex, NULL); return pthread_cond_init(&b->cond, NULL);
+}
+static inline int pthread_barrier_wait(pthread_barrier_t *b) {
+    pthread_mutex_lock(&b->mutex); unsigned generation = b->generation;
+    if (++b->waiting == b->count) { b->waiting = 0; b->generation++; pthread_cond_broadcast(&b->cond);
+        pthread_mutex_unlock(&b->mutex); return PTHREAD_BARRIER_SERIAL_THREAD; }
+    while (generation == b->generation) pthread_cond_wait(&b->cond, &b->mutex);
+    pthread_mutex_unlock(&b->mutex); return 0;
+}
+static inline int pthread_barrier_destroy(pthread_barrier_t *b) {
+    pthread_cond_destroy(&b->cond); return pthread_mutex_destroy(&b->mutex);
+}
+#ifdef QMODEM_WRAP_PTHREAD
+int __real_pthread_mutex_lock(pthread_mutex_t *) __asm__("_pthread_mutex_lock");
+int __real_pthread_join(pthread_t, void **) __asm__("_pthread_join");
+ssize_t __real_read(int, void *, size_t) __asm__("_read");
+int __wrap_pthread_mutex_lock(pthread_mutex_t *);
+int __wrap_pthread_join(pthread_t, void **);
+ssize_t __wrap_read(int, void *, size_t);
+#define pthread_mutex_lock __wrap_pthread_mutex_lock
+#define pthread_join __wrap_pthread_join
+#define read __wrap_read
+#endif
+#endif
+#endif
