diff --git a/application/tom_modem/tests/test_sms_transaction.c b/application/tom_modem/tests/test_sms_transaction.c
new file mode 100644
index 0000000..38b3d5b
--- /dev/null
+++ b/application/tom_modem/tests/test_sms_transaction.c
@@ -0,0 +1,62 @@
+/* Exercise the real sms_send operation with its transport boundary controlled.
+ * Prompt failure prevents payload writes; valid full-size PDUs remain intact. */
+#include "operations.h"
+#include "transport.h"
+#include <assert.h>
+#include <string.h>
+PROFILE_T s_profile;
+static int calls, fail_prompt;
+static const char *expected_cmgs = "AT+CMGS=2";
+static int large_pdu;
+static int nibble(char c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    assert(!"Invalid emitted payload hex"); return -1;
+}
+int transport_send_at_with_response(transport_t *t, PROFILE_T *p, const char *cmd,
+                                   const char *end, int raw, char **response) {
+    (void)t; calls++;
+    if (calls == 1) { assert(!strcmp(cmd, "AT+CMGF=0")); assert(!raw); }
+    if (calls == 2) { assert(!strcmp(cmd, expected_cmgs)); assert(!strcmp(end, ">")); return fail_prompt ? COMM_ERROR : SUCCESS; }
+    if (calls == 3) {
+        assert(raw); assert(!strcmp(end, "OK"));
+        if (!large_pdu) assert(!strcmp(cmd, "3030303130321A"));
+        else {
+            size_t len = strlen(p->sms_pdu);
+            assert(strlen(cmd) == len * 2 + 2);
+            for (size_t i = 0; i < len; i++)
+                assert((nibble(cmd[2*i]) * 16 + nibble(cmd[2*i+1])) == p->sms_pdu[i]);
+            assert(!strcmp(cmd + len * 2, "1A"));
+        }
+        *response = strdup("\r\n+CMGS: 1\r\nOK\r\n");
+    }
+    return SUCCESS;
+}
+int transport_send_at_only(transport_t *t, PROFILE_T *p, const char *cmd, int raw) {
+    (void)t; (void)p; (void)cmd; (void)raw; assert(!"SMS must wait for prompt"); return COMM_ERROR;
+}
+int main(void) {
+    PROFILE_T p = {0}; transport_t t = {0}; p.sms_pdu = "000102";
+    fail_prompt = 1; assert(sms_send(&p, &t) == COMM_ERROR); assert(calls == 2);
+    calls = 0; fail_prompt = 0; assert(sms_send(&p, &t) == SUCCESS); assert(calls == 3);
+    calls = 0; p.sms_pdu = "00zz"; assert(sms_send(&p, &t) == INVALID_PARAM); assert(calls == 0);
+
+    /* 70 UCS2 characters, destination 12345678901, 140 user-data bytes. */
+    char ucs2[311]; strcpy(ucs2, "0011000B912143658709F10008AA8C");
+    for (int i = 0; i < 70; i++) strcat(ucs2, "0041");
+    assert(strlen(ucs2) == 310);
+    calls = 0; large_pdu = 1; expected_cmgs = "AT+CMGS=154"; p.sms_pdu = ucs2;
+    assert(sms_send(&p, &t) == SUCCESS); assert(calls == 3);
+
+    /* Maximum transport envelope: SMSC length octet + 255 SMSC + 255 TPDU. */
+    char maximum[1023]; maximum[0] = maximum[1] = 'F';
+    memset(maximum + 2, 'A', 1020); maximum[1022] = 0;
+    calls = 0; expected_cmgs = "AT+CMGS=255"; p.sms_pdu = maximum;
+    assert(sms_send(&p, &t) == SUCCESS); assert(calls == 3);
+    /* A 256-byte TPDU with default SMSC is rejected before any modem writes. */
+    char too_long[515]; too_long[0] = too_long[1] = '0';
+    memset(too_long + 2, 'A', 512); too_long[514] = 0;
+    calls = 0; p.sms_pdu = too_long;
+    assert(sms_send(&p, &t) == INVALID_PARAM); assert(calls == 0);
+    puts("PASS SMS prompt/payload/final response, 70 UCS2 characters, maximum PDU and TPDU bounds");
+}
