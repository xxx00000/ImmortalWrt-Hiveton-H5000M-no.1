index 0000000..df986f0
--- /dev/null
+++ b/application/ubus_at_daemon/tests/test_shared_sessions.c
@@ -0,0 +1,151 @@
+/* Real PTY/TCP integration: catches ownership bypass, split SMS transactions,
+ * NUL truncation, late replies being reused, and reconnect regressions. */
+#include "ubus_at_daemon.h"
+#include <assert.h>
+#ifdef __APPLE__
+#include <util.h>
+#else
+#include <pty.h>
+#endif
+#include <arpa/inet.h>
+#include <sys/socket.h>
+#include <poll.h>
+
+at_daemon_ctx_t g_daemon_ctx;
+void process_incoming_data(at_port_instance_t *port, const char *line) { (void)port; (void)line; }
+void clear_event_callbacks(at_port_instance_t *port) { (void)port; }
+static const char *owner_a = "0123456789abcdef0123456789abcdef";
+static const char *owner_b = "abcdef0123456789abcdef0123456789";
+
+struct peer { int fd; const unsigned char *want; size_t len; const char *reply; };
+static void *reply_peer(void *data) {
+    struct peer *p = data;
+    unsigned char got[2048]; size_t used = 0;
+    while (used < p->len) {
+        struct pollfd f = { .fd = p->fd, .events = POLLIN };
+        assert(poll(&f, 1, 3000) > 0);
+        ssize_t n = read(p->fd, got + used, p->len - used);
+        assert(n > 0); used += (size_t)n;
+    }
+    assert(!memcmp(got, p->want, p->len));
+    assert(write(p->fd, p->reply, strlen(p->reply)) == (ssize_t)strlen(p->reply));
+    return NULL;
+}
+static int command(at_port_instance_t *port, int fd, const char *cmd,
+                   int raw, const char *end, const unsigned char *want,
+                   size_t len, const char *reply, at_response_t *response) {
+    pthread_t thread; struct peer peer = { fd, want, len, reply };
+    assert(!pthread_create(&thread, NULL, reply_peer, &peer));
+#ifdef TEST_TRANSPORT_ONLY
+    int result = send_at_command_with_response(port, cmd, 1, end, raw, response);
+#else
+    int result = at_session_send(port, owner_a, cmd, 1, end, raw, response);
+#endif
+    pthread_join(thread, NULL); return result;
+}
+static void test_pty(void) {
+    int master, slave; char path[128]; at_response_t response;
+    assert(openpty(&master, &slave, path, NULL, NULL) == 0);
+    close(slave);
+    at_port_instance_t *port = create_port_instance(path); assert(port);
+#ifdef TEST_TRANSPORT_ONLY
+    assert(open_at_port(port, 115200, 8, 0, 1) == 0);
+#else
+    assert(at_session_acquire(port, "bad", 120, 115200) == -2);
+    assert(at_session_acquire(port, owner_a, 0, 115200) == -2);
+    assert(at_session_acquire(port, owner_a, 120, 115200) == 0);
+    int fd = port->fd;
+    assert(at_session_acquire(port, owner_b, 120, 115200) == 1);
+    assert(at_session_release(port, owner_b) == -2);
+    assert(at_session_send(port, owner_b, "AT", 1, NULL, 0, &response) == -2);
+    assert(at_session_send(port, owner_a, "AT", 61, NULL, 0, &response) == -2);
+    assert(at_session_release(port, owner_a) == 0);
+    assert(at_session_acquire(port, owner_a, 120, 115200) == 0 && port->fd == fd);
+    char alias[256]; snprintf(alias, sizeof(alias), "/tmp/qmodem-alias-%ld", (long)getpid());
+    unlink(alias); assert(symlink(path, alias) == 0);
+    assert(find_port_instance(alias) == port);
+    assert(create_port_instance(alias) == port);
+    unlink(alias);
+#endif
+    assert(command(port, master, "AT", 0, NULL, (const unsigned char *)"AT\r\n", 4, "\r\nOK\r\n", &response) == 0);
+#ifndef TEST_TRANSPORT_ONLY
+    assert(at_session_send(port, owner_a, "41540d0a41540d0a", 1, NULL, 1, &response) == -2);
+#endif
+    assert(command(port, master, "AT+CMGS=4", 0, ">", (const unsigned char *)"AT+CMGS=4\r\n", 11, "\r\n> ", &response) == 0);
+#ifndef TEST_TRANSPORT_ONLY
+    assert(at_session_acquire(port, owner_b, 120, 115200) == 1);
+    assert(at_session_send(port, owner_a, "AT", 1, NULL, 0, &response) == -2);
+#endif
+    const unsigned char payload[] = { 'A', 0, 'B', 0x1a };
+    assert(command(port, master, "4100421a", 1, NULL, payload, sizeof(payload), "\r\n+CMGS: 1\r\nOK\r\n", &response) == 0);
+    assert(!strcmp(response.end_flag_matched, "OK"));
+    assert(command(port, master, "AT+FAIL", 0, "OK", (const unsigned char *)"AT+FAIL\r\n", 9, "\r\n+CME ERROR: 10\r\n", &response) == -2);
+#ifndef TEST_TRANSPORT_ONLY
+    /* The lease expiration must also cancel a prompt, not transfer SMS input. */
+    assert(command(port, master, "AT+CMGS=4", 0, ">", (const unsigned char *)"AT+CMGS=4\r\n", 11, "\r\n> ", &response) == 0);
+    struct peer cancel = { master, (const unsigned char *)"\x1b", 1, "\r\nOK\r\n" }; pthread_t cancel_thread;
+    assert(!pthread_create(&cancel_thread, NULL, reply_peer, &cancel));
+    assert(at_session_release(port, owner_a) == 0);
+    pthread_join(cancel_thread, NULL);
+    assert(at_session_acquire(port, owner_a, 1, 115200) == 0);
+    assert(command(port, master, "AT+CMGS=4", 0, ">", (const unsigned char *)"AT+CMGS=4\r\n", 11, "\r\n> ", &response) == 0);
+    assert(at_session_acquire(port, owner_a, 1, 115200) == 0);
+    sleep(2);
+    assert(!pthread_create(&cancel_thread, NULL, reply_peer, &cancel));
+    assert(at_session_acquire(port, owner_b, 120, 115200) == 0);
+    pthread_join(cancel_thread, NULL);
+    assert(at_session_release(port, owner_a) == -2);
+    assert(at_session_release(port, owner_b) == 0);
+    assert(at_session_acquire(port, owner_a, 120, 115200) == 0);
+    assert(at_session_send(port, owner_a, "AT+HANG", 1, NULL, 0, &response) == -1);
+    assert(write(master, "\r\nOK\r\n", 6) == 6); usleep(30000);
+    assert(at_session_release(port, owner_a) == -2);
+    assert(at_session_acquire(port, owner_b, 120, 115200) == -2);
+    assert(at_session_send(port, owner_a, "AT", 1, NULL, 0, &response) == -2);
+#endif
+    destroy_port_instance(port); close(master);
+}
+#ifndef TEST_TRANSPORT_ONLY
+static void test_oversize(void) {
+    int master, slave; char path[128]; at_response_t response;
+    assert(!openpty(&master, &slave, path, NULL, NULL)); close(slave);
+    at_port_instance_t *port = create_port_instance(path); assert(port);
+    assert(at_session_acquire(port, owner_a, 120, 115200) == 0);
+    char *reply = malloc(40016); assert(reply);
+    memset(reply, 'A', 40000); strcpy(reply + 40000, "\r\nOK\r\n");
+    assert(command(port, master, "AT+LONG", 0, NULL, (const unsigned char *)"AT+LONG\r\n", 9, reply, &response) == -2);
+    assert(at_session_acquire(port, owner_b, 120, 115200) == -2);
+    free(reply); destroy_port_instance(port); close(master);
+}
+static void test_tcp(void) {
+    int listener = socket(AF_INET, SOCK_STREAM, 0); assert(listener >= 0);
+    struct sockaddr_in addr = { .sin_family = AF_INET, .sin_addr.s_addr = htonl(INADDR_LOOPBACK) };
+    assert(!bind(listener, (struct sockaddr *)&addr, sizeof(addr))); assert(!listen(listener, 2));
+    socklen_t len = sizeof(addr); assert(!getsockname(listener, (struct sockaddr *)&addr, &len));
+    char endpoint[80]; snprintf(endpoint, sizeof(endpoint), "tcp://127.0.0.1:%u", ntohs(addr.sin_port));
+    at_port_instance_t *port = create_port_instance(endpoint); assert(port);
+    assert(at_session_acquire(port, owner_a, 120, 115200) == 0);
+    int peer = accept(listener, NULL, NULL); assert(peer >= 0); at_response_t response;
+    assert(command(port, peer, "AT", 0, NULL, (const unsigned char *)"AT\r\n", 4, "\r\nOK\r\n", &response) == 0);
+    assert(at_session_release(port, owner_a) == 0); close(peer); usleep(50000);
+    assert(at_session_acquire(port, owner_a, 120, 115200) == 0);
+    peer = accept(listener, NULL, NULL); assert(peer >= 0);
+    assert(command(port, peer, "AT", 0, NULL, (const unsigned char *)"AT\r\n", 4, "\r\nOK\r\n", &response) == 0);
+    assert(at_session_release(port, owner_a) == 0);
+    close(peer); destroy_port_instance(port); close(listener);
+    assert(!create_port_instance("tcp://localhost:1234"));
+    assert(!create_port_instance("tcp://127.0.0.1:0"));
+    assert(!create_port_instance("tcp://127.0.0.1:1234/extra"));
+}
+#endif
+int main(void) {
+    alarm(20); pthread_mutex_init(&g_daemon_ctx.ports_mutex, NULL);
+    assert(!at_line_events_init(&g_daemon_ctx.line_events));
+    (void)owner_a; (void)owner_b; test_pty();
+#ifndef TEST_TRANSPORT_ONLY
+    test_oversize();
+    test_tcp();
+#endif
+    at_line_events_cleanup(&g_daemon_ctx.line_events);
+    puts("PASS leases, alias ownership, PTY prompt/binary SMS, cancellation, timeout quarantine and TCP reconnect");
+}
