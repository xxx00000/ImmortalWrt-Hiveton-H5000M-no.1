+    local enabled ws_port allow_wan target
+    config_load at-webserver
+    config_get_bool enabled config enabled 1
+    [ "$enabled" = 1 ] || return 0
+    /usr/libexec/at-webserver-auth || return 1
+    config_get ws_port config websocket_port 8765
+    case "$ws_port" in ''|*[!0-9]*) return 1 ;; esac
+    [ "$ws_port" -ge 1 ] && [ "$ws_port" -le 65535 ] || return 1
+    config_get_bool allow_wan config websocket_allow_wan 0
+    target=REJECT
+    [ "$allow_wan" = 1 ] && target=ACCEPT
+    # Remove only rules created by the replaced Web package; an old ACCEPT
+    # must not take precedence over the current WAN restriction.
+    config_load firewall
+    config_foreach remove_old_web_rule rule
+    # Stable rule names avoid accumulating anonymous rules on each restart.
+    uci -q set firewall.h5000m_websocket=rule
+    uci -q set firewall.h5000m_websocket.name='H5000M WebSocket WAN'
+    uci -q set firewall.h5000m_websocket.src='wan'
+    uci -q set firewall.h5000m_websocket.enabled='1'
+    uci -q set firewall.h5000m_websocket.proto='tcp'
+    uci -q set "firewall.h5000m_websocket.dest_port=$ws_port"
+    uci -q set "firewall.h5000m_websocket.target=$target"
+    uci -q commit firewall || return 1
+    /etc/init.d/firewall reload >/dev/null 2>&1 || return 1
+    procd_open_instance
+    procd_set_param command /usr/bin/python3 -u /usr/bin/at-server.py
+    procd_set_param respawn 3600 5 5
+    procd_set_param stdout 1
+    procd_set_param stderr 1
+    procd_close_instance
 }
 
